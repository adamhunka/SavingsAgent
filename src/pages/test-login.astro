---
/**
 * src/pages/test-login.astro
 * Strona testowa dla weryfikacji logowania
 */

import Layout from "@/layouts/Layout.astro";

const supabase = Astro.locals.supabase;
const {
  data: { session },
} = await supabase.auth.getSession();

// Jeśli użytkownik nie jest zalogowany, przekieruj do logowania
if (!session) {
  return Astro.redirect("/login");
}

// Pobierz profil użytkownika
const { data: profile } = await supabase.from("profiles").select("role, email").eq("id", session.user.id).single();
---

<Layout title="SavingsAgent - Test Logowania">
  <div class="container mx-auto p-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold mb-4 text-neutral-900 dark:text-neutral-50">
        Test Logowania
      </h1>
      
      <div class="bg-card rounded-lg border p-6 mb-6">
        <h2 class="text-2xl font-semibold mb-4">✅ Logowanie Działa!</h2>
        <p class="text-muted-foreground mb-4">
          Zalogowano jako: <strong>{session.user.email}</strong>
        </p>
        <p class="text-muted-foreground mb-4">
          Rola: <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary">
            {profile?.role || "user"}
          </span>
        </p>
        <p class="text-sm text-muted-foreground">
          User ID: {session.user.id}
        </p>
      </div>

      <div class="bg-green-50 dark:bg-green-950 border border-green-200 dark:border-green-800 rounded-lg p-6 mb-6">
        <h3 class="text-lg font-semibold text-green-900 dark:text-green-100 mb-2">
          ✅ Test logowania zakończony sukcesem!
        </h3>
        <p class="text-green-700 dark:text-green-300">
          {profile?.role === "admin" 
            ? "Masz uprawnienia administratora."
            : "Przekierowanie dla użytkownika działa poprawnie."
          }
        </p>
      </div>

      <div class="flex gap-4 flex-wrap">
        <button
          onclick="window.location.href='/'"
          class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2"
        >
          📦 Lista Produktów
        </button>

        {profile?.role === "admin" && (
          <button
            onclick="window.location.href='/admin'"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-secondary text-secondary-foreground hover:bg-secondary/80 h-10 px-4 py-2"
          >
            ⚙️ Panel Administratora
          </button>
        )}
        
        <button
          onclick="document.getElementById('logout-form').submit()"
          class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
        >
          🚪 Wyloguj się
        </button>
      </div>

      <form id="logout-form" method="POST" action="/api/auth/logout" style="display: none;">
      </form>

      <div class="mt-8 p-4 bg-muted rounded-lg">
        <h3 class="font-semibold mb-2">ℹ️ Informacja</h3>
        <p class="text-sm text-muted-foreground">
          To jest strona testowa do weryfikacji logowania. 
          Kliknij "Lista Produktów" aby przejść do głównej aplikacji.
        </p>
      </div>
    </div>
  </div>
</Layout>

